# ===== APEX OTT 환경변수 =====
# 이 파일을 복사해 '.env' 로 저장한 뒤 값을 채우세요.

# 디스코드 봇 토큰 (필수)
DISCORD_TOKEN=

# Flask 세션 서명 키 (필수 · 아무 긴 랜덤 문자열)
SECRET_KEY=

# 봇 관리자 디스코드 ID (쉼표로 구분, 선택)
# 서버 관리자 권한이 있는 유저는 자동으로 관리자로 인식됩니다.
ADMIN_IDS=

# 웹 대시보드 관리자 비밀번호 (비우면 최초 실행 시 랜덤 생성 후 로그 출력)
ADMIN_PASSWORD=

# 슬래시 명령어를 즉시 동기화할 서버 ID (선택)
GUILD_ID=

# 웹 대시보드 포트
PORT=5000

# 외부 접속 주소 (선택 · 웹훅 URL 표시에 사용)
PUBLIC_URL=

# HTTPS 환경에서 세션 쿠키를 Secure 로 설정
COOKIE_SECURE=false

# 입금 웹훅 키 (선택 · 비워두면 자동 생성)
DEPOSIT_WEBHOOK_KEY=

# DB 파일 경로 (선택)
APEX_DB_PATH=
